#include <winver.h>
1 ICON "../assets/cerclic.ico"
1 24 "cerclic_open.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,7,1,0
PRODUCTVERSION 0,7,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "Said El Araifa"
      VALUE "FileDescription", "Cerclic, ouverture de la roue"
      VALUE "FileVersion", "0.7.1"
      VALUE "InternalName", "CerclicOpen"
      VALUE "LegalCopyright", "MIT"
      VALUE "OriginalFilename", "CerclicOpen.exe"
      VALUE "ProductName", "Cerclic"
      VALUE "ProductVersion", "0.7.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
